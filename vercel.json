{
  "crons": [
    {
      "path": "/api/contador",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/recebidas",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "api/contador.js": {
      "maxDuration": 60
    },
    "api/recebidas.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "notaoneapp.com.br"
        }
      ],
      "dest": "/site/index.html"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "www.notaoneapp.com.br"
        }
      ],
      "dest": "/site/index.html"
    },
    {
      "src": "/site",
      "dest": "/site/index.html"
    },
    {
      "src": "/site/cadastro",
      "dest": "/site/cadastro.html"
    },
    {
      "src": "/cadastro",
      "dest": "/site/cadastro.html"
    }
  ]
}
