{
  "crons": [
    {
      "path": "/api/contador",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/recebidas",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "api/contador.js": {
      "maxDuration": 60
    },
    "api/recebidas.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/site",
      "destination": "/site/index.html"
    },
    {
      "source": "/site/cadastro",
      "destination": "/site/cadastro.html"
    }
  ]
}
